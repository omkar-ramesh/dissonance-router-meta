# Database
DB_PATH=data/dissonance.db

# Meta Model API (OpenAI-compatible). Get a key at https://dev.meta.ai
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Optional overrides of models.toml, per tier (Meta Model API ids and reasoning effort)
# MODEL_NANO=muse-spark-1.3
# EFFORT_NANO=minimal
# EFFORT_ULTRA=high

# Who reads messages for style requests: nano (a short Muse Spark call, keywords as fallback) or keywords
SIGNAL_EXTRACTOR=nano

# Past conversations (Memory): compressed files here, deleted after N days unless kept
# MEMORY_DIR=data/memory
MEMORY_RETENTION_DAYS=10

# Public demo mode for a hosted link: private random session ids, per-IP rate limit,
# output caps and a daily spend cut-off.
PUBLIC_DEMO=0
# RATE_LIMIT_PER_MIN=6
# DAILY_BUDGET_USD=1.00
# MAX_TOKENS_ULTRA=4000

# Optional judges-only access code for a hosted demo (every request needs it)
# DEMO_ACCESS_CODE=
